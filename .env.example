# MiMo (Xiaomi) — cookie string from platform.xiaomimimo.com/api/v1/balance
# Must include api-platform_serviceToken and userId cookies
MIMO_COOKIE=api-platform_serviceToken=...; userId=...
# Optional: override MiMo API base URL
# MIMO_API_URL=https://platform.xiaomimimo.com

# MiniMax Token Plan
MINIMAX_API_KEY=mm-your-token-plan-key-here

# Ollama Cloud — API key from ollama.com/settings
OLLAMA_CLOUD_API_KEY=osk-...

# OpenCode Go — API key for usage API
# OPENCODE_GO_API_KEY=...
# Value of the __Host-console_session cookie from the opencode.ai console
# (log in, devtools → cookies). No cookie-name prefix — value only.
OPENCODE_GO_SESSION_COOKIE=...
# Workspace ID, sent as the x-org-id header to opencode.ai/console/api
OPENCODE_GO_WORKSPACE_ID=wrk_...
# OpenCode Go (second account) — __Host-console_session value + workspace id
# OPENCODE_GO_2_SESSION_COOKIE=...
# OPENCODE_GO_2_WORKSPACE_ID=wrk_...

# OpenCode Zen — dollar balance is read from the opencode.ai console billing API
# using the OpenCode Go session cookie + workspace id above (same account).
# No extra vars.

# OpenRouter — API key for credits endpoint (openrouter.ai/api/v1/credits)
OPENROUTER_API_KEY=sk-or-...

# Command Code — session token cookie value from commandcode.ai (settings/usage page)
# Use the value of the __Secure-commandcode_prod_.session_token cookie
COMMANDCODE_SESSION_TOKEN=...

# OpenAI Codex — OAuth access token
OPENAI_CODEX_ACCESS_TOKEN=eyJ...

# Tavily — API key for usage endpoint
TAVILY_API_KEY=tvly-...
# Tavily (second account) — API key for usage endpoint
TAVILY_API_KEY_2=tvly-...
# Tavily (third account) — API key for usage endpoint
TAVILY_API_KEY_3=tvly-...

# Kimi Code — bearer/access token for coding usage endpoint (from env only, not file)
KIMI_API_KEY=...

# Z.AI — API key for quota usage endpoint
ZAI_API_KEY=...
# GLM fallback for Z.AI
# GLM_API_KEY=...

# Synthetic — API key for quotas endpoint
SYNTHETIC_API_KEY=syn_...

# routing.sh / ai.routing.sh — preferred API key for user request usage endpoint (rk_...)
ROUTING_RUN_API_KEY=rk_...
# Legacy routing.sh access token fallback
# ROUTING_SH_ACCESS_TOKEN=...

# Context7 — session cookies from dashboard scraping
# Cookies are refreshed on every request; update them as needed.
# CONTEXT7_SESSION_COOKIE=__session=...; __session_4mvfbYGz=...

# Server port (default: 3001)
PORT=3001

# Log level for the structured stdout logs read by journald.
# Allowed: trace, debug, info, warn, error, fatal, silent (default: info)
# LOG_LEVEL=info

# Pi coding agent session logs (read-only) — indexed for the /p-charts token usage page
# PI_SESSIONS_DIR=~/.pi/agent/sessions

# Alibaba Cloud Model Studio (Qwen Token Plan) — full cookie header from
# https://modelstudio.console.alibabacloud.com (devtools → Network → any request → cookie)
ALIBABA_QWEN_COOKIE=

# Silent-SSO keepalive: every ALIBABA_QWEN_KEEPALIVE_HOURS the CDP browser
# navigates a tab to the console page so the long-lived havana SSO cookies
# re-mint the short-lived login ticket. 0 disables the keepalive.
# ALIBABA_QWEN_KEEPALIVE_HOURS=6

# Chrome DevTools endpoint used by the cookie auto-refresh (Context7, Command Code,
# Alibaba Qwen). Defaults to http://127.0.0.1:9222 (native Chrome started with
# --remote-debugging-port=9222). If the logged-in Chrome runs in a container,
# start scripts/cdp-proxy.mjs and point this at it:
# CHROME_CDP_URL=http://127.0.0.1:9333

# Desktop notifications (notify-send) when the watchdog opens a login-required
# alert — the dashboard alert alone is too easy to miss. Defaults to true.
# DESKTOP_NOTIFY=true

# Web UI of the containerized Chrome, used for manual logins; named in the
# session-expired error so the login surface is one click away.
# Defaults to http://127.0.0.1:13000.
# CHROME_UI_URL=http://127.0.0.1:13000
